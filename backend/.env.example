# Copy this file to ".env" (same folder) and fill in the two values below.
# Never commit .env: it is listed in .gitignore.

# Supabase: Project Settings -> Database -> Connection string -> "Session pooler".
# Looks like: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Google AI Studio -> Get API key (free tier).
GEMINI_API_KEY=

# Optional settings (defaults shown).
# gemini-2.5-flash from the original spec is deprecated and closed to new users.
GEMINI_MODEL=gemini-3.6-flash
# Seconds to wait between Gemini calls, to stay inside the free-tier rate limit.
LLM_DELAY_SECONDS=7
# Set to 0 to run the API without the background poller.
ENABLE_SCHEDULER=1
# Address of your own RSSHub instance, for example https://rsshub.example.com
# Leave empty to keep the RSSHub-only sources (Anthropic, X accounts, 36Kr, GitHub Trending) off.
# The public https://rsshub.app blocks automated requests, so it does not work here.
RSSHUB_BASE=
