# Copy this file to reels/.env and fill in the values. Never commit reels/.env.

# ElevenLabs: generates the voiceover in the cloned voice (elevenlabs.io -> Developers -> API Keys)
ELEVENLABS_API_KEY=

# fal.ai: talking avatar (optional, not used for the AI page yet)
FAL_KEY=

# Instagram posting (optional until the account is connected; see tools/INSTAGRAM_SETUP.md)
IG_ACCESS_TOKEN=
